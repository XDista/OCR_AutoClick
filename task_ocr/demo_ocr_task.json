{
    "_schema": "ocr_task_v1",
    "_description": "OCR文字识别任务组 - AND/OR逻辑演示",
    "_workflow": "每个TASK执行流程：截取目标窗口 → OCR识别截图中的所有文字 → 在识别结果中按targets顺序匹配目标文字 → 首个命中则执行对应actions",

    "ocr_settings": {
        "language": ["ch_sim", "en"],
        "confidence_threshold": 0.5,
        "preprocess": {
            "grayscale": false,
            "threshold_enabled": false,
            "threshold_value": 127,
            "scale": 1.0
        }
    },

    "TASK1": {
        "desc": "OR逻辑（短路）：OCR结果中包含'确认'或'确定'或'OK'任一即触发",
        "targets": [
            {
                "desc": "截图出现'确认'/'确定'/'OK'中任意一个 → 点击",
                "text": ["or", "确认", "确定", "OK"],
                "match_mode": "contains",
                "match_times": 1,
                "reverse_match": false,
                "region": [0, 0, 1920, 1080],
                "actions": [
                    {
                        "type": "click",
                        "params": [460, 340],
                        "desc": "点击确认弹窗"
                    },
                    {
                        "type": "sleep",
                        "params": [1.5]
                    }
                ]
            }
        ]
    },

    "TASK2": {
        "desc": "AND逻辑：OCR结果中同时包含'胜利'和'结算'才触发",
        "targets": [
            {
                "desc": "截图同时出现'胜利'和'结算' → 执行点击",
                "text": ["and", "胜利", "结算"],
                "match_mode": "contains",
                "match_times": 1,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "click",
                        "params": [960, 600],
                        "desc": "点击胜利结算"
                    },
                    {
                        "type": "sleep",
                        "params": [2.0]
                    },
                    {
                        "type": "goto_task",
                        "params": [1]
                    }
                ]
            },
            {
                "desc": "备选：仅出现'返回'文字 → 点击返回",
                "text": "返回",
                "match_mode": "contains",
                "match_times": 1,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "click",
                        "params": [100, 50],
                        "desc": "点击返回按钮"
                    },
                    {
                        "type": "sleep",
                        "params": [1.0]
                    },
                    {
                        "type": "goto_task",
                        "params": [1]
                    }
                ]
            }
        ]
    },

    "TASK3": {
        "desc": "AND + 反向匹配：连续3次没有同时出现'战斗中'和'暂停' → 战斗结束",
        "targets": [
            {
                "desc": "连续3次截图都不同时出现'战斗中'和'暂停' → 点击",
                "text": ["and", "战斗中", "暂停"],
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": true,
                "region": [0, 0, 300, 100],
                "actions": [
                    {
                        "type": "click",
                        "params": [960, 540],
                        "desc": "战斗结束后的操作"
                    },
                    {
                        "type": "sleep",
                        "params": [1.0]
                    },
                    {
                        "type": "goto_task",
                        "params": [1]
                    }
                ]
            }
        ]
    }
}