{
    "_schema": "ocr_task_v1",
    "_description": "顺序执行任务 1-2（使用Playwright）",
    "_workflow": "使用OCR文字识别替代图像匹配，检测调度器状态并执行相应操作",

    "ocr_settings": {
        "language": ["ch_sim", "en"],
        "confidence_threshold": 0.5,
        "preprocess": {
            "grayscale": false,
            "threshold_enabled": false,
            "threshold_value": 127,
            "scale": 1.0
        }
    },

    "TASK1": {
        "desc": "检查调度器状态：正在运行则停止并重启应用",
        "targets": [
            {
                "desc": "检测到'调度器'和'停止' → 正在运行，重启游戏并切换为调度器1",
                "text": ["and", "调度器", "停止"],
                "match_mode": "contains",
                "match_times": 2,
                "reverse_match": false,
                "region": [280, 60, 588, 250],
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "cmd_call",
                        "params": ["python ./refs/alas-switch/from_2_to_1-alas.py"]
                    },
                    {
                        "type": "serial_adbcall",
                        "params": ["adb shell am force-stop com.bilibili.azurlane"]
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "click",
                        "params": [40, 150]
                    },
                    {
                        "type": "sleep",
                        "params": [2.0]
                    },
                    {
                        "type": "click",
                        "params": [40, 150]
                    }
                ]
            }
        ]
    },

    "TASK2": {
        "desc": "检测到运行完毕 → 切换为调度器2",
        "targets": [
            {
                "desc": "检测到'无任务'提示 → 运行完毕，切换为调度器2",
                "text": ["and", "调度器", "运行中", "无任务","停止"],
                "match_mode": "contains",
                "match_times": 2,
                "reverse_match": false,
                "region": [280, 60, 588, 250],
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "cmd_call",
                        "params": ["python ./refs/alas-switch/from_1_to_2-alas.py"]
                    },
                    {
                        "type": "click",
                        "params": [40, 205]
                    },
                    {
                        "type": "sleep",
                        "params": [1.0]
                    },
                    {
                        "type": "click",
                        "params": [40, 205]
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "stop",
                        "params": []
                    }
                ]
            }
        ]
    }
}