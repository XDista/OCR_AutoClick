{
    "_schema": "ocr_task_v1",
    "_description": "顺序执行任务 1-4（从模板匹配迁移）",
    "_workflow": "使用OCR文字识别替代图像匹配，检测调度器状态并执行相应操作",

    "ocr_settings": {
        "language": ["ch_sim", "en"],
        "confidence_threshold": 0.5,
        "preprocess": {
            "grayscale": false,
            "threshold_enabled": false,
            "threshold_value": 127,
            "scale": 1.0
        }
    },

    "TASK1": {
        "desc": "检查调度器状态：如果正在运行则停止并重启应用，如果未运行则直接重启应用",
        "targets": [
            {
                "desc": "检测到'调度器'和'停止' → 正在运行，点击停止并重启应用",
                "text": ["and", "调度器", "停止"],
                "match_mode": "contains",
                "match_times": 2,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "click",
                        "params": [545, 90],
                        "desc": "点击停止按钮"
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "serial_adbcall",
                        "params": ["adb shell am force-stop com.bilibili.azurlane"]
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    }
                ]
            },
            {
                "desc": "检测到'调度器'和'启动' → 未运行，直接重启应用",
                "text": ["and", "调度器", "启动"],
                "match_mode": "contains",
                "match_times": 2,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "serial_adbcall",
                        "params": ["adb shell am force-stop com.bilibili.azurlane"]
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    }
                ]
            }
        ]
    },

    "TASK2": {
        "desc": "检测到未运行状态 → 点击位置(40,150)两次",
        "targets": [
            {
                "desc": "检测到'启动'按钮 → 未运行，点击指定位置",
                "text": "启动",
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "click",
                        "params": [40, 150]
                    },
                    {
                        "type": "sleep",
                        "params": [1.0]
                    },
                    {
                        "type": "click",
                        "params": [40, 150]
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    }
                ]
            }
        ]
    },

    "TASK3": {
        "desc": "检测到未运行状态 → 点击启动按钮并等待",
        "targets": [
            {
                "desc": "检测到'启动'按钮 → 未运行，点击启动按钮",
                "text": "启动",
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "click",
                        "params": [545, 90],
                        "desc": "点击启动按钮"
                    },
                    {
                        "type": "sleep",
                        "params": [15.0]
                    }
                ]
            }
        ]
    },

    "TASK4": {
        "desc": "检查是否所有任务完成：如果完成则点击停止，如果未运行则返回TASK3",
        "targets": [
            {
                "desc": "检测到'调度器'、'停止'、'运行中'和'无任务' → 所有任务完成，点击停止",
                "text": ["and", "调度器", "停止", "运行中", "无任务"],
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "click",
                        "params": [545, 90],
                        "desc": "点击停止按钮"
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    }
                ]
            },
            {
                "desc": "检测到'启动'按钮 → 未运行，返回TASK3",
                "text": "启动",
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "goto_task",
                        "params": [3]
                    }
                ]
            }
        ]
    },

    "TASK5": {
        "desc": "检查状态：如果未运行则点击位置(40,320)，如果所有任务完成则返回TASK4",
        "targets": [
            {
                "desc": "检测到'启动'按钮 → 未运行，点击指定位置",
                "text": "启动",
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "click",
                        "params": [40, 320]
                    },
                    {
                        "type": "sleep",
                        "params": [1.0]
                    },
                    {
                        "type": "click",
                        "params": [40, 320]
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    }
                ]
            },
            {
                "desc": "检测到'调度器'、'停止'、'运行中'和'无任务' → 所有任务完成，返回TASK4",
                "text": ["and", "调度器", "停止", "运行中", "无任务"],
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "goto_task",
                        "params": [4]
                    }
                ]
            }
        ]
    },

    "TASK6": {
        "desc": "检测到未运行状态 → 点击启动按钮",
        "targets": [
            {
                "desc": "检测到'启动'按钮 → 未运行，点击启动按钮",
                "text": "启动",
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "click",
                        "params": [545, 90],
                        "desc": "点击启动按钮"
                    },
                    {
                        "type": "sleep",
                        "params": [5.0]
                    }
                ]
            }
        ]
    },

    "TASK7": {
        "desc": "检查最终状态：如果正在运行则停止，如果未运行则返回TASK6",
        "targets": [
            {
                "desc": "检测到'调度器'和'停止' → 正在运行，停止任务",
                "text": ["and", "调度器", "停止"],
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "stop",
                        "params": []
                    }
                ]
            },
            {
                "desc": "检测到'启动'按钮 → 未运行，返回TASK6",
                "text": "启动",
                "match_mode": "contains",
                "match_times": 3,
                "reverse_match": false,
                "actions": [
                    {
                        "type": "sleep",
                        "params": [5.0]
                    },
                    {
                        "type": "goto_task",
                        "params": [6]
                    }
                ]
            }
        ]
    }
}